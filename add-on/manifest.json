{
  "description": "Sing your articles!",
  "manifest_version": 2,
  "name": "Turn articles into songs!",
  "version": "1.0",
  "icons": {
    "48": "icons/songify.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "article_singer@example.org",
      "strict_min_version": "50.0"
    }
  },

  "background": {
    "scripts": ["logger.js", "prompts.js", "background.js"]
  },

  "browser_action": {
    "default_icon": "icons/songify.png"
  },

  "permissions": [
    "activeTab",
    "downloads",
    "menus",
    "notifications",
    "storage",
    "https://api.anthropic.com/*",
    "https://api.sunoapi.org/*",
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["Readability.js", "content_script.js"]
    }
  ],

  "options_ui": {
    "page": "options.html"
  }
}

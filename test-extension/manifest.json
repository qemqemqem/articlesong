{
  "manifest_version": 2,
  "name": "Suno Test - Minimal",
  "version": "0.0.1",
  "description": "Minimal test extension to verify Suno API access with cookies",
  
  "icons": {
    "48": "icon.png"
  },

  "permissions": [
    "cookies",
    "notifications",
    "https://studio-api.suno.ai/*",
    "https://app.suno.ai/*",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "browser_action": {
    "default_title": "Test Suno API - Click to send request!"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "suno-test@example.org",
      "strict_min_version": "50.0"
    }
  }
}


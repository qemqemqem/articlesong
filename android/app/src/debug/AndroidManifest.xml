<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Debug builds only: `just push-keys` sets API keys over adb so you don't type them on the phone. -->
        <receiver
            android:name=".DebugConfigReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.articlesong.app.debug.CONFIGURE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
